{
  "manifest_version": 3,
  "name": "Daily English Gate",
  "version": "1.0",
  "description": "每天開 Chrome 自動開啟 ChatGPT + 10 分鐘英語練習倒數",
  "permissions": ["storage", "tabs", "alarms", "windows", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Daily English Gate",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
